/* Info.plist의 NS*UsageDescription 키를 영어(기본 개발 언어)로 현지화함 */
"NSLocalNetworkUsageDescription" = "Intragram talks only to other devices on your local Wi-Fi to exchange messages and files. Nothing is sent to the internet.";
"NSMicrophoneUsageDescription" = "Intragram records a voice message only while you hold the mic button, or after you tap it for hands-free recording until you send or cancel. Audio is sent to the peer and kept in memory, never saved to disk.";
