<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 로컬 네트워크만 씀. Android는 사설 LAN 주소라도 TCP 소켓을 열려면 INTERNET이 필요함
         (앱은 공인 IP로 절대 안 나감, lib/core/network_guard.dart 참고) -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- Android 17+의 LAN 권한만 요청함. 주변 Wi-Fi 기기 권한은 선언 안 함 -->
    <!-- Android 13+: 백그라운드에서 메시지가 오면 띄우는 로컬 알림. 런타임에 물어보고 푸시 서비스·네트워크는 안 씀 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 다른 기기 코드를 앱 안에서 QR로 스캔함. 카메라 플러그인이 런타임에 물어보고 프레임은 기기에서
         순수 Dart(ZXing)로 풂 (카메라는 QR 읽기에만 씀). 플러그인이 camera.any를 필수로, 옛 Android
         저장소 쓰기(병합하면 읽기도 따라옴)를 요구해서 아래서 다 꺼 둠: 카메라 없는 폰도 설치되고 저장하는 것도 없음 -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false"
        tools:replace="android:required"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove"/>
    <!-- 눌러서 녹음하는 음성 메시지. record 플러그인이 런타임에 물어보고 소리는 RAM에만 두고 저장 안 함 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- Android 14+: 대화를 스크린샷하면 알아채서 상대에게 알림 (감지만 하고 막지는 못함).
         일반 권한이라 묻는 창이 없고 API 34 밑에선 아무 일도 안 함 -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE"/>
    <!-- 옵트인 '백그라운드에서 연결 유지': remoteMessaging 포그라운드 서비스(가까운 기기끼리 메시지 전달)가
         프로세스를 붙잡아서 백그라운드에서도 피어 링크가 살아 있음. 기본 꺼짐이고 쓰던 사설 LAN 밖으론 안 나감 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- allowBackup=false: 옵트인 보관소와 신원 파일이 앱 데이터 폴더에 있어서 안 끄면 Auto Backup이
         사용자 클라우드로 올림 (제로 디스크 약속 위반) -->
    <application
        android:label="Intragram"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Flutter UI가 뜨는 동안 보이고 그 뒤로도 창 배경을 정하는 테마 -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 옵트인 백그라운드 연결 유지 (설정 → 백그라운드에서 연결 유지). 사용자가 켜야만 시작됨 -->
        <service
            android:name=".ConnectionService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="remoteMessaging" />

        <!-- 아래 meta-data는 지우면 안 됨 (Flutter 도구가 GeneratedPluginRegistrant.java를 만들 때 씀) -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Flutter 엔진의 ProcessTextPlugin이 텍스트 처리 앱을 찾을 때 필요함 (패키지 가시성,
         https://developer.android.com/training/package-visibility) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
